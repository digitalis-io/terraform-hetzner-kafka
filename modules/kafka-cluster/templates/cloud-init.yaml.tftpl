#cloud-config
# Rendered by modules/kafka-cluster for every node. Applied at server creation
# only (hcloud_server ignores user_data changes).
write_files:
  - path: /etc/netplan/60-hetzner-private.yaml
    owner: root:root
    permissions: "0600"
    content: |
      ${indent(6, netplan)}
%{ if device != "" ~}
  - path: /usr/local/sbin/kafka-mount-data-volume
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, script)}
%{ endif ~}
runcmd:
  - ["netplan", "apply"]
%{ if device != "" ~}
  - ["/usr/local/sbin/kafka-mount-data-volume", "${device}", "${mount_point}"]
%{ endif ~}
