{
  "permissions": {
    "allow": [
      "Bash(tofu fmt:*)",
      "Bash(tofu validate:*)",
      "Bash(tofu plan:*)",
      "Bash(tofu init:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform init:*)",
      "Bash(tflint:*)",
      "Bash(trivy config:*)",
      "Bash(terraform-docs:*)",
      "Bash(pre-commit run:*)",
      "Bash(pre-commit install:*)",
      "Bash(tofu --version)",
      "Bash(terraform --version)",
      "Bash(tflint --version)",
      "Bash(make plan)",
      "Bash(make fmt)",
      "Bash(make docs)",
      "Bash(make help)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(tofu destroy:*)",
      "Bash(terraform destroy:*)",
      "Bash(tofu apply:*)",
      "Bash(terraform apply:*)",
      "Bash(make apply)",
      "Bash(make destroy)"
    ],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); cmd=$(echo \"$input\" | python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('command',''))\" 2>/dev/null || echo \"\"); if echo \"$cmd\" | grep -qE '^git commit'; then cd \"$(git rev-parse --show-toplevel)\" && pre-commit run --files $(git diff --cached --name-only | tr '\\n' ' ') 2>&1 || true; fi"
          }
        ]
      }
    ]
  }
}
